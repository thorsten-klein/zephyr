# Copyright (c) 2025 Wolfgang Birkner
# SPDX-License-Identifier: Apache-2.0

menuconfig BSHBUS_DUMMY
	bool "Dummy BSH Bus Controller Support"
	default n
	select SPI
	help
	  Enable the Dummy BSH D-Bus module driver backend for BSH Bus communication.

if BSHBUS_DUMMY

config BSHBUS_DUMMY_THREAD_STACK_SIZE
	int "Stack size for the Dummy BSH D-Bus interrupt thread"
	default 4096
	help
	  Size of the stack used for the thread handling interrupts and dispatching callbacks.

config BSHBUS_DUMMY_THREAD_PRIO
	int "Priority for the Dummy BSH D-Bus interrupt thread"
	default 0
	help
	  Priority level for the thread handling interrupts and dispatching callbacks.

endif # BSHBUS_DUMMY
